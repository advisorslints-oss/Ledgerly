{
  "name": "ledgerly",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first double-entry accounting for any business, on any device.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "build": "npm run typecheck && vite build",
    "build:offline": "vite build --mode file",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit && tsc -p tests --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
